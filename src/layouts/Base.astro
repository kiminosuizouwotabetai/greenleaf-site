---
const { title = 'Сервисный центр Greenleaf в Геленджике | Официальный партнёр' } = Astro.props;
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<!doctype html>
<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/svg+xml" href="/favicon.png" />
  <meta name="description" content="Сервисный центр Greenleaf в Геленджике. Премиальный уход, витамины, товары для дома и одежды. Помощь с выбором и оформлением заказа." />
  <title>{title}</title>
</head>
<body>
  <Header />
  <main><slot /></main>
  <Footer />
</body>
</html>

<style is:global>
  :root {
    --brand-green: #179B49;
    --brand-green-dark: #00682E;
    --brand-green-light: #eaf3ee;
    
    --bg-body: #F3F4F6;
    --bg-card: #FFFFFF;
    
    --text: #1a1a1a;
    --text-muted: #5a6b60;
    
    --border-color: #e0e8e2;
    --gold: #d4a02a;
  }

  * { box-sizing: border-box; }

  body {
    margin: 0;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    color: var(--text);
    background: var(--bg-body);
    line-height: 1.6;
  }

  a { color: var(--brand-green); text-decoration: none; transition: color 0.2s; }
  a:hover { color: var(--brand-green-dark); }
  .container { max-width: 1120px; margin: 0 auto; padding: 0 20px; }

  h1, h2, h3 { color: var(--text); line-height: 1.2; }
  h1 { font-size: clamp(2rem, 4vw, 3rem); margin: 0 0 20px; }
  h2 { font-size: clamp(1.5rem, 3vw, 2.2rem); margin: 0 0 16px; }

  .btn {
    display: inline-block;
    padding: 12px 24px;
    background: var(--brand-green);
    color: white;
    border-radius: 0;
    font-weight: 600;
    transition: background 0.2s;
    border: 2px solid transparent;
    cursor: pointer;
  }
  .btn:hover { background: var(--brand-green-dark); color: white; }

  .btn-outline {
    background: transparent;
    color: var(--brand-green);
    border: 2px solid var(--brand-green);
  }
  .btn-outline:hover { background: var(--brand-green); color: white; }

  section { padding: 60px 0; }

  .bg-light-green {
    background-color: #f4faf6;
    background-image: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M30 5C25 5 20 10 20 15C20 20 25 25 30 25C35 25 40 20 40 15C40 10 35 5 30 5Z' fill='%23179B49' fill-opacity='0.06'/%3E%3Cpath d='M15 35C10 35 5 40 5 45C5 50 10 55 15 55C20 55 25 50 25 45C25 40 20 35 15 35Z' fill='%23179B49' fill-opacity='0.06'/%3E%3Cpath d='M45 35C40 35 35 40 35 45C35 50 40 55 45 55C50 55 55 50 55 45C55 40 50 35 45 35Z' fill='%23179B49' fill-opacity='0.06'/%3E%3C/svg%3E");
    background-repeat: repeat;
    border-top: 1px solid var(--border-color);
    border-bottom: 1px solid var(--border-color);
  }
</style>