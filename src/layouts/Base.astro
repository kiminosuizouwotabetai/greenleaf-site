---
const { title = 'Greenleaf — ваш партнёр' } = Astro.props;
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<!doctype html>
<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>{title}</title>
</head>
<body>
  <Header />
  <main><slot /></main>
  <Footer />
</body>
</html>

<style is:global>
:root {

  --green-900: #0f1f16;
  --green-700: #1a3d2e;
  --green-500: #2e6b4f;
  --green-100: #e6f2ea;
  
  --text: #111111;
  --muted: #4a4a4a;
  --cream: #f4faf6;
  
  --gold: #b8860b;
}
  * { box-sizing: border-box; }
  body {
    margin: 0;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    color: var(--text);
    background: var(--cream);
    line-height: 1.6;
  }
  a { color: var(--green-700); text-decoration: none; }
  a:hover { color: var(--green-900); }
  .container { max-width: 1120px; margin: 0 auto; padding: 0 20px; }
  h1, h2, h3 { color: var(--green-900); line-height: 1.2; }
  h1 { font-size: clamp(2rem, 4vw, 3rem); margin: 0 0 20px; }
  h2 { font-size: clamp(1.5rem, 3vw, 2.2rem); margin: 0 0 16px; }
  .btn {
    display: inline-block;
    padding: 12px 24px;
    background: var(--green-700);
    color: white;
    border-radius: 0;
    font-weight: 600;
    transition: background 0.2s;
    border: 2px solid transparent;
  }
  
  .btn:hover { background: var(--green-900); color: white; }
  
  .btn-outline {
    background: transparent;
    color: var(--green-700);
    border: 2px solid var(--green-700);
  }
  
  .btn-outline:hover { background: var(--green-700); color: white; }

</style>