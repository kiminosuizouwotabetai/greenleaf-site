---
import { defaultPartner } from '../data/partners.js';

const year = new Date().getFullYear();
const { partner = defaultPartner } = Astro.props;
---
<footer class="site-footer">
  <div class="container">
    <p>© {year} {partner.fullName}, г. {partner.city}</p>
    <p class="muted">Сайт носит информационный характер. Является личной страницей официального партнёра Greenleaf.</p>
  </div>
</footer>

<style>
  .site-footer { background: var(--brand-green-dark); color: #ffffff; padding: 30px 0; margin-top: 60px; text-align: center; font-size: 0.9rem; }
  .site-footer p { margin: 4px 0; }
  .muted { opacity: 0.7; font-size: 0.8rem; color: #d8f3dc; }
</style>
