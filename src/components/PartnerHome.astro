    </div>
  </section>

  <div class="divider"></div>

  <section class="start-sets">
    <div class="container">
      <h2 data-kicker="Для новых партнёров">Стартовые наборы</h2>
      <p class="sets-subtitle">Наборы составляет компания и отправляет новым партнёрам бесплатно</p>
      
      <div class="sets-grid">
        <div class="set-card" data-target="modal1">
