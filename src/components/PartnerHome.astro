---
import Base from '../layouts/Base.astro';

const { partner } = Astro.props;
const contactsHref = `/partners/${partner.slug}/contacts/`;
---
<Base title={partner.title} description={partner.description} partner={partner}>
  
  <section class="hero">
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="container hero-inner">
      <div class="hero-text">
        <span class="eyebrow">{partner.fullName}, {partner.role}</span>
        <h1>Здоровье, красота и качество жизни — вместе с Greenleaf</h1>
        <p>Представляем продукцию международной компании Greenleaf</p>
        <div class="hero-actions">
          <a href={contactsHref} class="btn btn-contact">Контакты</a>
          <a href="/catalog" class="btn btn-outline">Смотреть каталог</a>
          <a href="/about" class="btn btn-outline">О компании</a>
        </div>
        <div class="hero-facts">
          <div class="fact"><b data-count="885">885</b><span>товаров в каталоге</span></div>
          <div class="fact"><b data-count="16">16</b><span>категорий продукции</span></div>
          <div class="fact fact-text"><span>Доставка по России</span></div>
        </div>
      </div>
      <div class="hero-visual">
        <div class="hero-image-wrapper">
          <img src={partner.photo} alt={partner.fullName} fetchpriority="high" decoding="async" />
        </div>
      </div>
    </div>
  </section>

  <div class="divider"></div>

  <section class="video-section bg-light-green">
    <div class="container">
      <h2 data-kicker="О компании">Презентация компании</h2>
      <div class="video-wrapper">
        <video controls controlsList="nodownload" preload="none" poster="/video-poster-preza.webp">
          <source src="/preza.mp4" type="video/mp4" />
        </video>
      </div>
    </div>
  </section>

  <div class="divider"></div>

  <section class="company-info">
    <div class="container">
      <h2 data-kicker="Наши принципы">Философия Greenleaf</h2>
      <div class="grid-info">
        <div class="info-card">
          <div class="info-icon">
            <img src="/favicon.png" alt="Стратегия" />
          </div>
          <h3>Стратегия компании</h3>
          <p>Распространение высококачественной продукции по разумной цене на мировом рынке.</p>
        </div>
        <div class="info-card">
          <div class="info-icon">
            <img src="/favicon.png" alt="Миссия" />
          </div>
          <h3>Миссия компании</h3>
          <p>Сделать людей счастливее, здоровее, красивее и богаче.</p>
        </div>
        <div class="info-card">
          <div class="info-icon">
            <img src="/favicon.png" alt="Ценности" />
          </div>
          <h3>Ценности компании</h3>
          <p>Гармония, альтруизм по отношению к себе, честность, преданность делу, полная отдача и инновация.</p>
        </div>
        <div class="info-card">
          <div class="info-icon">
            <img src="/favicon.png" alt="Программа" />
          </div>
          <h3>Программа компании</h3>
          <p>Стать лучшим работодателем на мировом уровне, крупнейшей платформой качественных продуктов.</p>
        </div>
      </div>
    </div>
  </section>

  <div class="divider"></div>

  <section class="products-video-section bg-light-green">
    <div class="container">
      <h2 data-kicker="О продукции">Продукция компании</h2>
      <div class="video-wrapper">
        <video controls controlsList="nodownload" preload="none" poster="/video-poster-world.webp">
          <source src="/glworld.mp4" type="video/mp4" />
        </video>
      </div>
    </div>
  </section>

  <div class="divider"></div>

  <section class="partnership">
    <div class="container">
      <div class="partnership-header">
        <h2 data-kicker="Бизнес с Greenleaf">Как стать партнёром и начать получать доход</h2>
        <p class="lead">Знаете ли вы, что на товарах, которыми мы пользуемся ежедневно, можно построить прибыльный бизнес? Один раз выбираем и оплачиваем стартовый пакет — и запускаем свой доход.</p>
      </div>
      
      <div class="steps-grid">
        <div class="step-card">
          <div class="step-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 8V21H3V8M1 3H23V8H1V3ZM10 12H14M12 12V21M12 12H10" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </div>
          <h3>Стартовый пакет</h3>
          <p>Один раз оплачиваете стартовый пакет стоимостью <strong>28 900 ₽</strong>.</p>
        </div>
        
        <div class="step-card">
          <div class="step-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </div>
          <h3>Бизнес-место и скидка</h3>
          <p>Получаете бизнес-место в системе, готовое к выплатам, и партнерскую скидку <strong>50%</strong> на все покупки.</p>
        </div>
        
        <div class="step-card">
          <div class="step-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 1V23M17 5H9.5C8.57174 5 7.6815 5.36875 7.02513 6.02513C6.36875 6.6815 6 7.57174 6 8.5C6 9.42826 6.36875 10.3185 7.02513 10.9749C7.6815 11.6313 8.57174 12 9.5 12H14.5C15.4283 12 16.3185 12.3687 16.9749 13.0251C17.6313 13.6815 18 14.5717 18 15.5C18 16.4283 17.6313 17.3185 16.9749 17.9749C16.3185 18.6313 15.4283 19 14.5 19H6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </div>
          <h3>Достойный доход</h3>
          <p>Приглашаете друзей и знакомых — получаете доход каждый день плюс один раз в месяц.</p>
        </div>
      </div>

      <div class="bonus-scheme">
        <h3>Бинарная партнёрская структура</h3>
        
        <div class="svg-container">
            <svg viewBox="0 0 500 300" class="scheme-svg">
            <!-- Линии -->
            <line x1="250" y1="60" x2="100" y2="220" stroke="var(--brand-green)" stroke-width="2" />
            <line x1="250" y1="60" x2="400" y2="220" stroke="var(--brand-green)" stroke-width="2" />
            <!-- Центральная высота -->
            <line x1="250" y1="60" x2="250" y2="220" stroke="var(--brand-green)" stroke-width="2" />
            <!-- Нижняя горизонтальная линия -->
            <line x1="100" y1="220" x2="400" y2="220" stroke="var(--brand-green)" stroke-width="2" stroke-dasharray="5,5" />

            <!-- 5852 вдоль центральной линии -->
                        <text x="242" y="155" text-anchor="middle" fill="var(--brand-green-dark)" font-weight="bold" font-size="16" transform="rotate(-90, 242, 155)">5852</text>
            
            <!-- 1828 на нижней стороне по центру -->
            <text x="250" y="245" text-anchor="middle" fill="var(--brand-green-dark)" font-weight="bold" font-size="16">1828</text>

            <!-- Круги поверх линий -->
            <!-- Верхний круг -->
            <circle cx="250" cy="60" r="35" fill="var(--bg-card)" stroke="var(--brand-green)" stroke-width="2" />
            <text x="250" y="66" text-anchor="middle" fill="var(--brand-green-dark)" font-weight="bold" font-size="16">28900</text>

            <!-- Левый нижний круг -->
            <circle cx="100" cy="220" r="35" fill="var(--bg-card)" stroke="var(--brand-green)" stroke-width="2" />
            <text x="100" y="226" text-anchor="middle" fill="var(--brand-green-dark)" font-weight="bold" font-size="16">914</text>

            <!-- Правый нижний круг -->
            <circle cx="400" cy="220" r="35" fill="var(--bg-card)" stroke="var(--brand-green)" stroke-width="2" />
            <text x="400" y="226" text-anchor="middle" fill="var(--brand-green-dark)" font-weight="bold" font-size="16">914</text>
          </svg>
        </div>

        <div class="total-sum">
          Сумма к выплате: <strong>9 508 рублей</strong>
        </div>
        
        <p class="scheme-desc">Схема наглядно показывает распределение прибыли. Значения указаны в рублях.</p>
      </div>

      <div class="partnership-action">
        <a href={contactsHref} class="btn">Свяжитесь со мной, чтобы узнать подробности</a>
      </div>
    </div>
  </section>

