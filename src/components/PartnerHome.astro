      <p>Свяжитесь со мной — расскажу о продукции и возможностях бизнеса с Greenleaf.</p>
      <a href={contactsHref} class="btn">Написать мне</a>
    </div>
  </section>

  <script is:inline>
(() => {
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const targets = [];

  // ---- что анимируем ----
  document.querySelectorAll('main section').forEach((sec) => {
    if (sec.classList.contains('hero')) return;
    sec.querySelectorAll('.container > *').forEach((el, i) => {
      el.classList.add('reveal');
      el.style.setProperty('--d', (i * 90) + 'ms');
      targets.push(el);
    });
  });

  document.querySelectorAll('.grid-info, .steps-grid, .sets-grid').forEach((grid) => {
    [...grid.children].forEach((card, i) => {
      card.classList.add('reveal');
      card.style.setProperty('--d', (i * 90) + 'ms');
      targets.push(card);
    });
  });

  document.querySelectorAll('h2[data-kicker]').forEach((h) => {
    h.classList.add('reveal');
    targets.push(h);
  });

  // ---- числа в схеме ----
  const scheme = document.querySelector('.scheme-svg');
  const schemeNums = scheme
    ? [...scheme.querySelectorAll('text')].filter((t) => /^\d+$/.test(t.textContent.trim()))
    : [];
  schemeNums.forEach((t) => { t.dataset.target = t.textContent.trim(); t.textContent = '0'; });

  const animateNum = (el, target, dur = 1100) => {
    const t0 = performance.now();
    const step = (t) => {
      const p = Math.min(1, (t - t0) / dur);
      const eased = 1 - Math.pow(1 - p, 3);
      el.textContent = String(Math.round(target * eased));
      if (p < 1) requestAnimationFrame(step);
    };
    requestAnimationFrame(step);
  };

  // ---- счётчики в герое ----
  const counters = document.querySelectorAll('[data-count]');

  if (reduce) {
    targets.forEach((el) => el.classList.add('is-visible'));
    schemeNums.forEach((t) => { t.textContent = t.dataset.target; });
    return;
  }

  const io = new IntersectionObserver((entries) => {
    entries.forEach((e) => {
      if (!e.isIntersecting) return;
      e.target.classList.add('is-visible');
      io.unobserve(e.target);
    });
  }, { threshold: 0.1, rootMargin: '0px 0px -50px 0px' });
  targets.forEach((el) => io.observe(el));

  const cio = new IntersectionObserver((entries) => {
    entries.forEach((e) => {
      if (!e.isIntersecting) return;
      const el = e.target;
      const target = Number(el.dataset.count) || 0;
      const dur = 1300;
      const t0 = performance.now();
      const tick = (t) => {
        const p = Math.min(1, (t - t0) / dur);
        const eased = 1 - Math.pow(1 - p, 3);
        el.textContent = Math.round(target * eased).toLocaleString('ru-RU');
        if (p < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
      cio.unobserve(el);
    });
  }, { threshold: 0.5 });
  counters.forEach((c) => cio.observe(c));

  // ---- числа схемы: запускаем при появлении блока ----
  if (scheme && schemeNums.length) {
    const sio = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (!e.isIntersecting) return;
        schemeNums.forEach((t, i) => {
          setTimeout(() => animateNum(t, Number(t.dataset.target)), i * 130);
        });
        sio.disconnect();
      });
    }, { threshold: 0.35 });
    sio.observe(scheme);
  }

  // ---- лёгкий параллакс паттерна ----
  const patterns = [...document.querySelectorAll('.bg-light-green')];
  if (patterns.length && !reduce) {
    let ticking = false;
    const move = () => {
      patterns.forEach((sec) => {
        const r = sec.getBoundingClientRect();
        sec.style.backgroundPositionY = Math.round(-r.top * 0.12) + 'px';
