---
import { formatPhone } from '../data/partners.js';

const { partner } = Astro.props;
const c = partner.contacts || {};
const phones = c.phones || [];
const telegramHref = c.telegram ? `https://t.me/${c.telegram}` : null;
---
<section class="contacts-section">
  <div class="container narrow">
    <h1>Связаться с партнёром</h1>
    <p class="lead">
      {partner.fullName} — {partner.role} Greenleaf, г. {partner.city}. Отвечу на вопросы
      о продукции, помогу с заказом или расскажу о бизнесе с Greenleaf.
    </p>

    <div class="contact-grid">

      {phones.map((phone) => (
        <a href={`tel:${phone}`} class="contact-card">
          <div class="contact-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </div>
          <h3>Телефон</h3>
          <p>{formatPhone(phone)}</p>
        </a>
      ))}

      {c.max && (
        <a href={c.max} target="_blank" rel="noopener" class="contact-card">
          <div class="contact-icon">
            <img src="/max.png" alt="MAX" class="contact-img-icon" />
          </div>
          <h3>MAX</h3>
          <p>Напишите мне в MAX</p>
        </a>
      )}

      {telegramHref && (
        <a href={telegramHref} target="_blank" rel="noopener" class="contact-card">
          <div class="contact-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21.5 4.5L2.9 11.2c-.9.3-.9 1.5 0 1.8l4.4 1.5 1.7 5.2c.2.7 1.1.9 1.6.3l2.4-2.5 4.6 3.4c.7.5 1.6.1 1.8-.7l3-13.9c.2-.9-.7-1.6-1.4-1.3z" stroke-linecap="round" stroke-linejoin="round"/><path d="M7.3 14.5l10.6-7.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </div>
          <h3>Telegram</h3>
          <p>@{c.telegram}</p>
        </a>
      )}

      {c.vk && (
        <a href={c.vk} target="_blank" rel="noopener" class="contact-card">
          <div class="contact-icon">
            <img src="/vk.webp" alt="ВКонтакте" class="contact-img-icon" />
          </div>
          <h3>ВКонтакте</h3>
          <p>Написать в личные сообщения</p>
        </a>
      )}

      {c.email && (
        <a href={`mailto:${c.email}`} class="contact-card">
          <div class="contact-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </div>
          <h3>Email</h3>
          <p>{c.email}</p>
        </a>
      )}

    </div>

    <div class="note">
      <p>
        {phones.length > 0
          ? 'Для оперативной связи лучше всего использовать мессенджеры или позвонить по телефону.'
          : 'Для связи используйте мессенджеры — отвечу быстро.'}
      </p>
    </div>
  </div>
</section>

<style>
  .contacts-section { padding: 80px 0; background: var(--bg-body); }
  .narrow { max-width: 900px; margin: 0 auto; padding: 0 20px; }
  h1 { text-align: center; margin-bottom: 15px; }
  .lead { color: var(--text-muted); font-size: 1.1rem; margin: 0 auto 40px; text-align: center; max-width: 640px; }

  .contact-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 20px;
    margin-bottom: 40px;
  }

  .contact-card {
    background: var(--bg-card);
    padding: 30px 20px;
    border: 1px solid var(--border-color);
    border-top: 4px solid var(--brand-green);
    text-align: center;
    transition: transform 0.2s, box-shadow 0.2s;
    display: flex;
    flex-direction: column;
    align-items: center;
    color: var(--text);
    overflow: hidden;
    width: 100%;
    max-width: 280px;
  }

  .contact-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.08);
    border-color: var(--brand-green);
  }

  .contact-icon {
    width: 40px;
    height: 40px;
    color: var(--brand-green);
    margin-bottom: 15px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .contact-icon svg { width: 100%; height: 100%; }

  .contact-img-icon {
    width: 40px;
    height: 40px;
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    display: block;
  }

  .contact-card h3 { margin: 0 0 10px 0; font-size: 1.2rem; color: var(--text); }
  .contact-card p { margin: 0; color: var(--text-muted); font-size: 0.95rem; }

  .note {
    padding: 20px;
    background: var(--brand-green-light);
    border-left: 4px solid var(--brand-green);
    text-align: center;
    color: var(--brand-green-dark);
    font-size: 0.95rem;
    max-width: 700px;
    margin: 0 auto;
  }

  .note p { margin: 0; }
</style>
