          <div class="contact-icon">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M13.162 18.994c.609 0 .858-.406.851-.915-.031-1.917.714-2.949 2.059-1.604 1.488 1.488 1.796 2.519 3.603 2.519h3.2c.808 0 1.126-.26 1.126-.668 0-.863-1.421-2.386-2.625-3.504-1.686-1.565-1.765-1.602-.313-3.486 1.801-2.339 4.157-5.336 2.073-5.336h-3.981c-.772 0-.828.435-1.103 1.083-.995 2.347-2.886 5.387-3.604 4.922-.751-.485-.407-2.406-.35-5.261.015-.754.011-1.271-1.141-1.539-.814-.18-1.958-.274-2.975-.274-1.925 0-3.205.415-3.205 2.01 0 .702.375 1.236.803 1.628.56.511.635 1.534.635 1.534s-.403 3.822-.94 5.39c-.543 1.588-1.25 1.127-2.37-.55-1.164-1.74-2.178-4.29-2.178-4.29s-.134-.553-.586-.884c-.585-.429-1.37-.6-1.37-.6s-1.883-.018-2.242.073c-.626.158-.626.65-.626.65s.958 1.34 2.094 2.905c1.603 2.208 3.459 5.518 3.459 5.518s.927 2.153 2.618 2.153h.674z"/></svg>
          </div>
          <h3>ВКонтакте</h3>
          <p>Написать в личные сообщения</p>
        </a>

        <a href="mailto:ваша_почта@mail.ru" class="contact-card">
          <div class="contact-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" stroke-linecap="round" stroke-linejoin="round"/></svg>
