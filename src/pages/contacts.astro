        </a>

        <a href="https://t.me/ВАШ_НИКНЕЙМ" target="_blank" class="contact-card">
          <div class="contact-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21.736 3.26c-.43-.39-1.15-.49-1.76-.24L2.63 9.74c-.64.26-.66 1.16-.04 1.46l4.26 2.04 1.95 6.13c.15.47.77.58 1.07.18l2.48-3.3 4.26 3.13c.42.31 1.02.09 1.16-.42l3.5-14.4c.12-.52-.22-1.02-.73-1.2l-.48-.16zM9.2 13.62l8.46-5.31-6.98 6.65-.33 3.32-1.15-4.66z" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </div>
