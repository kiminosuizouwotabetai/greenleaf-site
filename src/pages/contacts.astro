---
import Base from '../layouts/Base.astro';
---
<Base title="Контакты — Сервисный центр Greenleaf в Геленджике">
  <section class="contacts-section">
    <div class="container narrow">
      <h1>Связаться со мной</h1>
      <p class="lead">Отвечу на вопросы о продукции, помогу с заказом или расскажу о бизнесе с Greenleaf.</p>

      <div class="contact-grid">
        
        <a href="tel:+79384289200" class="contact-card">
          <div class="contact-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </div>
          <h3>Телефон</h3>
          <p>+7 (938) 428-92-00</p>
        </a>

        <a href="https://max.ru/u/f9LHodD0cOKb4Eyczebr3LMVLosYcO9pub7ipqg8pGUVWp6DB4G-sq9B6c0" target="_blank" class="contact-card">
          <div class="contact-icon">
            <img src="/max.png" alt="MAX" class="contact-img-icon" />
          </div>
          <h3>MAX</h3>
          <p>Напишите мне в MAX</p>
        </a>

        <a href="https://vk.com/ВАШ_НИКНЕЙМ" target="_blank" class="contact-card">
          <div class="contact-icon">
            <img src="/vk.webp" alt="ВКонтакте" class="contact-img-icon" />
          </div>
          <h3>ВКонтакте</h3>
          <p>Написать в личные сообщения</p>
        </a>

        <a href="mailto:natalytoloknova1978@gmail.com" class="contact-card">
          <div class="contact-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </div>
          <h3>Email</h3>
          <p>natalytoloknova1978@gmail.com</p>
        </a>

      </div>

      <div class="note">
        <p>Для оперативной связи лучше всего использовать мессенджеры или позвонить по телефону.</p>
      </div>
    </div>
  </section>
</Base>

<style>
  .contacts-section { padding: 80px 0; background: var(--bg-body); }
  .narrow { max-width: 900px; margin: 0 auto; padding: 0 20px; }
  h1 { text-align: center; margin-bottom: 15px; }
  .lead { color: var(--text-muted); font-size: 1.1rem; margin: 0 auto 40px; text-align: center; max-width: 600px; }

  .contact-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 20px;
    margin-bottom: 40px;
  }

  .contact-card {
    background: var(--bg-card);
    padding: 30px 20px;
    border: 1px solid var(--border-color);
    border-top: 4px solid var(--brand-green);
    text-align: center;
    transition: transform 0.2s, box-shadow 0.2s;
    display: flex;
    flex-direction: column;
    align-items: center;
    color: var(--text);
    overflow: hidden; 
    width: 100%;
    max-width: 280px;
  }

  .contact-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.08);
    border-color: var(--brand-green);
  }

  .contact-icon {
    width: 40px;
    height: 40px;
    color: var(--brand-green);
    margin-bottom: 15px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .contact-icon svg {
    width: 100%;
    height: 100%;
  }

  .contact-img-icon {
    width: 40px;
    height: 40px;
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    display: block;
  }

  .contact-card h3 {
    margin: 0 0 10px 0;
    font-size: 1.2rem;
    color: var(--text);
  }

  .contact-card p {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.95rem;
  }

  .note {
    padding: 20px;
    background: var(--brand-green-light);
    border-left: 4px solid var(--brand-green);
    text-align: center;
    color: var(--brand-green-dark);
    font-size: 0.95rem;
    max-width: 700px;
    margin: 0 auto;
  }
  
  .note p { margin: 0; }
</style>