      </div>

      <div class="note">
        <p>Для оперативной связи лучше всего использовать мессенджеры (Telegram, MAX) или позвонить по телефону.</p>
      </div>
    </div>
  </section>
</Base>

<style>
  .contacts-section { padding: 80px 0; background: var(--bg-body); }
  .narrow { max-width: 900px; margin: 0 auto; padding: 0 20px; }
  h1 { text-align: center; margin-bottom: 15px; }
  .lead { color: var(--text-muted); font-size: 1.1rem; margin: 0 auto 40px; text-align: center; max-width: 600px; }

  .contact-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 20px;
    margin-bottom: 40px;
  }

  .contact-card {
    background: var(--bg-card);
    padding: 30px 20px;
    border: 1px solid var(--border-color);
    border-top: 4px solid var(--brand-green);
    text-align: center;
    transition: transform 0.2s, box-shadow 0.2s;
    display: flex;
    flex-direction: column;
    align-items: center;
    color: var(--text);
  }

  .contact-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.08);
    border-color: var(--brand-green);
  }

  .contact-icon {
    width: 40px;
    height: 40px;
    color: var(--brand-green);
    margin-bottom: 15px;
  }

  .contact-icon svg {
    width: 100%;
    height: 100%;
  }

  .contact-card h3 {
    margin: 0 0 10px 0;
    font-size: 1.2rem;
    color: var(--text);
  }

  .contact-card p {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.95rem;
  }

  .note {
    padding: 20px;
    background: var(--brand-green-light);
    border-left: 4px solid var(--brand-green);
    text-align: center;
    color: var(--brand-green-dark);
    font-size: 0.95rem;
  }
  
  .note p { margin: 0; }
</style>