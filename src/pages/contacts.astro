---
import Base from '../layouts/Base.astro';
import ContactsSection from '../components/ContactsSection.astro';
import { defaultPartner } from '../data/partners.js';
---
<Base
  title={`Контакты — ${defaultPartner.fullName}, Greenleaf в Геленджике`}
  description={`Связаться с ${defaultPartner.fullName} — ${defaultPartner.role} Greenleaf в Геленджике: телефоны, MAX, Telegram.`}
  partner={defaultPartner}
>
  <ContactsSection partner={defaultPartner} />
</Base>
