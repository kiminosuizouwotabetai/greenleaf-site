---
import Base from '../layouts/Base.astro';
import products from '../data/products.json';

const categories = [
  { key: 'sealuxe', name: 'SEALUXE', desc: 'Премиальный уход за кожей' },
  { key: 'carich', name: 'Carich', desc: 'Витамины и БАДы' },
  { key: 'ilife', name: 'iLiFE', desc: 'Товары для здоровья и дома' },
  { key: 'marvisia', name: 'Marvisia', desc: 'Одежда и аксессуары' },
];
const featured = products.filter(p => p.featured).slice(0, 3);
---
<Base title="Сервисный центр Greenleaf в Геленджике — Здоровье и красота">
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-text">
        <span class="eyebrow">НАТАЛИЯ ТОЛОКНОВА, VIP-ПАРТНЁР</span>
        <h1>Здоровье, красота и качество жизни — вместе с Greenleaf</h1>
        <p>Представляем продукцию международной компании Greenleaf</p>
        
        <div class="hero-actions">
          <a href="/catalog" class="btn">Смотреть каталог</a>
          <a href="/about" class="btn btn-outline">О компании</a>
        </div>
      </div>
      <div class="hero-visual">
  <div class="hero-image-wrapper">
    <img src="/i.png" alt="Сервисный центр Greenleaf" />
  </div>
</div>
    </div>
  </section>

  <section class="company-info">
    <div class="container">
      <h2>Философия Greenleaf</h2>
      <div class="grid-info">
        
        <div class="info-card">
          <div class="info-icon">
            <img src="/favicon.png" alt="Стратегия" />
          </div>
          <h3>Стратегия компании</h3>
          <p>Распространение высококачественной продукции по разумной цене на мировом рынке.</p>
        </div>

        <div class="info-card">
          <div class="info-icon">
            <img src="/favicon.png" alt="Миссия" />
          </div>
          <h3>Миссия компании</h3>
          <p>Сделать людей счастливее, здоровее, красивее и богаче.</p>
        </div>

        <div class="info-card">
          <div class="info-icon">
            <img src="/favicon.png" alt="Ценности" />
          </div>
          <h3>Ценности компании</h3>
          <p>Гармония, альтруизм по отношению к себе, честность, преданность делу, полная отдача и инновация.</p>
        </div>

        <div class="info-card">
          <div class="info-icon">
            <img src="/favicon.png" alt="Программа" />
          </div>
          <h3>Программа компании</h3>
          <p>Стать лучшим работодателем на мировом уровне, крупнейшей платформой качественных продуктов.</p>
        </div>

      </div>
    </div>
  </section>

  <section class="featured">
    <div class="container">
      <h2>Популярные товары</h2>
      <div class="grid-products">
        {featured.map(p => (
          <a href="/catalog" class="card-link">
            <div class="mini-card">
              <h3>{p.name}</h3>
              <p>{p.short}</p>
              <span class="category-tag">{p.categoryName}</span>
            </div>
          </a>
        ))}
      </div>
      <div style="text-align: center; margin-top: 30px;">
        <a href="/catalog" class="btn btn-outline">Весь каталог</a>
      </div>
    </div>
  </section>

  <section class="cta">
    <div class="container">
      <h2>Хотите узнать больше?</h2>
      <p>Свяжитесь со мной — расскажу о продукции и возможностях бизнеса с Greenleaf.</p>
      <a href="/contacts" class="btn">Написать мне</a>
    </div>
  </section>
</Base>

<style>
  .hero-image-wrapper {
    width: 100%;
    max-width: 450px;
    border: 4px solid var(--brand-green);
    box-shadow: 0 15px 30px rgba(0, 0, 0, 0.1);
    margin: 0 auto;
  }

  .hero-image-wrapper img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }
  .hero-inner { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; align-items: center; }
  .eyebrow { display: inline-block; color: var(--green-700); font-weight: 600; font-size: 0.9rem; letter-spacing: 1px; text-transform: uppercase; margin-bottom: 12px; }
  .hero-text p { font-size: 1.1rem; color: var(--muted); margin: 0 0 28px; }
  .hero-actions { display: flex; gap: 12px; flex-wrap: wrap; }
  .hero-visual { display: flex; justify-content: center; align-items: center; }
  .hero-avatar {
    width: 320px;
    height: 320px;
    border-radius: 50%;
    overflow: hidden;
    border: 4px solid var(--green-700);
    box-shadow: 0 10px 30px rgba(15, 31, 22, 0.15);
    background-color: var(--green-100);
  }

  .hero-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .company-info {
    background-color: transparent;
  }

  .grid-info {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 20px;
  }

  .info-card {
    background: var(--bg-card);
    padding: 30px 24px;
    border: 1px solid var(--border-color);
    border-top: 4px solid var(--brand-green);
    display: flex;
    flex-direction: column;
    transition: transform 0.2s, box-shadow 0.2s;
    text-align: center;
  }

  .info-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 20px rgba(0, 0, 0, 0.05);
  }

  .info-icon {
    height: 60px;
    margin-bottom: 20px;
    display: flex;
    align-items: center;
    justify-content: center; 
  }

  .info-icon img {
    height: 100%;
    width: auto;
    object-fit: contain;
  }

  .info-card h3 {
    font-size: 1.1rem;
    margin: 0 0 12px 0;
    color: var(--text);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .info-card p {
    color: var(--text-muted);
    font-size: 0.9rem;
    margin: 0;
    line-height: 1.5;
  }
  .mini-card { background: white; padding: 24px; border-radius: 0; box-shadow: 0 2px 8px rgba(0,0,0,0.05); height: 100%; transition: all 0.2s; border-left: 4px solid var(--gold); }
  .mini-card:hover { transform: translateY(-3px); box-shadow: 0 8px 20px rgba(0,0,0,0.08); }
  .mini-card h3 { margin: 0 0 8px; font-size: 1.05rem; }
  .mini-card p { margin: 0 0 12px; color: var(--muted); font-size: 0.9rem; }
  .category-tag { display: inline-block; background: var(--green-100); color: var(--green-900); padding: 4px 10px; border-radius: 0; font-size: 0.8rem; font-weight: 600; }
  .cta { background: var(--green-100); text-align: center; }
  .cta p { color: var(--muted); max-width: 500px; margin: 0 auto 24px; }
  @media (max-width: 768px) {
    .hero-inner { grid-template-columns: 1fr; }
    .hero-visual { display: none; }
    .hero { padding: 50px 0; }
  }
</style>