---
import Base from '../../layouts/Base.astro';
import { partnerList } from '../../data/partners.js';

const title = 'Партнёры Greenleaf в Геленджике';
const description =
  'Официальные партнёры Greenleaf в Геленджике: выберите своего партнёра, чтобы узнать о нём и связаться напрямую.';
---
<Base title={title} description={description}>
  <section class="partners-section">
    <div class="container">
      <h1>Наши партнёры</h1>
      <p class="lead">
        В Геленджике с вами работают официальные партнёры Greenleaf. Выберите человека,
        с которым вам удобнее общаться, — у каждого свой каталог, свои контакты и свой подход.
      </p>

      <div class="partners-grid">
        {partnerList.map((p) => (
          <article class="partner-card">
            <div class="partner-photo">
              <img src={p.photo} alt={p.fullName} loading="lazy" />
            </div>
            <div class="partner-body">
              <span class="partner-role">{p.role}</span>
              <h2>{p.fullName}</h2>
              <p class="partner-city">г. {p.city}</p>
              <div class="partner-actions">
                <a href={`/partners/${p.slug}/`} class="btn">Открыть страницу</a>
                <a href={`/partners/${p.slug}/contacts/`} class="btn btn-outline">Контакты</a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .partners-section { padding: 70px 0 90px; background: var(--bg-body); }
  h1 { text-align: center; margin-bottom: 14px; }
  .lead {
    color: var(--text-muted); font-size: 1.05rem; text-align: center;
    max-width: 680px; margin: 0 auto 50px;
  }

  .partners-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 30px;
    max-width: 900px;
    margin: 0 auto;
  }

  .partner-card {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-top: 4px solid var(--brand-green);
    display: flex;
    flex-direction: column;
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .partner-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.08);
  }

  .partner-photo {
    width: 100%;
    height: 300px;
    background: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
    border-bottom: 1px solid var(--border-color);
  }

  .partner-photo img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    display: block;
  }

  .partner-body { padding: 24px 20px 26px; display: flex; flex-direction: column; flex-grow: 1; }

  .partner-role {
    display: inline-block;
    align-self: flex-start;
    background: var(--brand-green-light);
    color: var(--brand-green-dark);
    padding: 4px 10px;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 12px;
  }

  .partner-body h2 { font-size: 1.25rem; margin: 0 0 8px; line-height: 1.3; }
  .partner-city { color: var(--text-muted); margin: 0 0 22px; font-size: 0.95rem; flex-grow: 1; }

  .partner-actions { display: flex; flex-wrap: wrap; gap: 10px; }
  .partner-actions .btn { padding: 10px 18px; font-size: 0.9rem; }

  @media (max-width: 600px) {
    .partner-photo { height: 260px; }
    .partner-actions { flex-direction: column; }
    .partner-actions .btn { text-align: center; }
  }
</style>
