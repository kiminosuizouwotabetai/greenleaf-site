---
import Base from '../layouts/Base.astro';
import Database from 'better-sqlite3';
import path from 'path';

const db = new Database(path.join(process.cwd(), 'data', 'catalog.db'), { readonly: true });
const allProducts = db.prepare('SELECT * FROM products ORDER BY sort_order, id').all();

const products = allProducts.map((p) => ({
  ...p,
  images: JSON.parse(p.images),
}));

const categories = ['Все', ...new Set(products.map((p) => p.category))];
const subcategories = ['Все', ...new Set(products.map((p) => p.subcategory))];
const brands = ['Все', ...new Set(products.map((p) => p.brand).filter(Boolean).sort((a, b) => a.localeCompare(b, 'ru')))];

// пастельные цвета подкатегорий — в тон палитре сайта
const TAG_PALETTE = [
  { bg: '#E8F5EC', fg: '#1E6D3A' }, // мята
  { bg: '#FBEDE4', fg: '#8A4B2A' }, // персик
  { bg: '#EEEAF7', fg: '#4B3A73' }, // лаванда
  { bg: '#E6F1F8', fg: '#22536B' }, // небесный
  { bg: '#F8F1E2', fg: '#6B5326' }, // песок
  { bg: '#FBEAEE', fg: '#7A2F43' }, // роза
  { bg: '#E4F4F2', fg: '#1F5F58' }, // аква
  { bg: '#EFF5E0', fg: '#4C6A24' }, // фисташка
  { bg: '#ECEEFA', fg: '#3C3F78' }, // перивинкль
  { bg: '#F4EAF3', fg: '#6A3A64' }, // мокко
  { bg: '#F0F2E3', fg: '#555E2B' }, // олива
  { bg: '#FDEDE7', fg: '#8A4130' }, // коралл
  { bg: '#E9F0F7', fg: '#2C5170' }, // пудрово-голубой
  { bg: '#FBF6E4', fg: '#6E5A22' }, // крем
  { bg: '#F3E9F0', fg: '#5E3552' }, // слива
  { bg: '#EAF2E1', fg: '#3F6B2E' }, // шалфей
  { bg: '#FBEFE9', fg: '#7A4630' }, // терракота
  { bg: '#F7F0F4', fg: '#6B3A56' }, // лавандово-розовый
  { bg: '#E7F3F0', fg: '#1D5C56' }, // тил
  { bg: '#F6F3EA', fg: '#5F5533' }, // лён
  { bg: '#EFF2F8', fg: '#33436B' }, // туман
  { bg: '#F9F0E9', fg: '#74492F' }, // карамель
];

const tagColor = new Map(
  subcategories.filter((c) => c !== 'Все').map((c, i) => [c, TAG_PALETTE[i % TAG_PALETTE.length]]),
);
---
<Base
  title="Каталог продукции — Greenleaf в Геленджике"
  description="Каталог продукции Greenleaf: уход за кожей лица, основной и комплексный уход, маски. Оформление заказа через партнёра в Геленджике."
>
  <section class="catalog-section">
    <div class="container">
      <h1>Каталог продукции</h1>
      <p class="lead">Ознакомьтесь с ассортиментом. Для заказа свяжитесь со мной.</p>

      <div class="catalog-layout">
        <aside class="catalog-sidebar" id="catalogSidebar">
          <button type="button" class="filters-toggle" id="filtersToggle" aria-expanded="false" aria-controls="filtersBody">
            <span class="filters-toggle-label">Фильтры</span>
            <span class="filters-toggle-count" id="filtersCount" hidden></span>
            <svg class="filters-toggle-chevron" viewBox="0 0 12 8" width="12" height="8" aria-hidden="true">
              <path d="M1 1.5L6 6.5L11 1.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>

          <div class="filters-body" id="filtersBody">
            <div class="filter-block">
              <h2 class="filter-title">Поиск</h2>
              <input
                type="search"
                id="searchInput"
                class="search-input"
                placeholder="Название или артикул"
                autocomplete="off"
                aria-label="Поиск по каталогу"
              />
            </div>

            <div class="filter-block">
            <h2 class="filter-title">Категория</h2>
            <div class="filters" id="catFilters">
              {categories.map((c) => (
                <button
                  type="button"
                  class="filter-btn"
                  class:list={[{ active: c === 'Все' }]}
                  data-type="category"
                  data-value={c}
                >{c}</button>
              ))}
            </div>
          </div>

          <div class="filter-block">
            <h2 class="filter-title">Подкатегория</h2>
            <div class="filters" id="subcatFilters">
              {subcategories.map((c) => (
                <button
                  type="button"
                  class="filter-btn"
                  class:list={[{ active: c === 'Все' }]}
                  data-type="subcategory"
                  data-value={c}
                  style={c !== 'Все' ? `--tag-bg:${tagColor.get(c).bg}` : undefined}
                >{c}</button>
              ))}
            </div>
          </div>

          <div class="filter-block">
            <h2 class="filter-title">Бренд</h2>
            <div class="filters" id="brandFilters">
              {brands.map((c) => (
                <button
                  type="button"
                  class="filter-btn"
                  class:list={[{ active: c === 'Все' }]}
                  data-type="brand"
                  data-value={c}
                >{c}</button>
              ))}
            </div>
          </div>

          <button type="button" class="filter-reset" id="resetFilters">Сбросить фильтры</button>
          </div>
        </aside>

        <div class="catalog-main">
          <div class="catalog-toolbar">
            <span class="catalog-count" id="catalogCount">{products.length} товаров</span>
            <label class="sort-label">
              <span>Сортировка:</span>
              <select id="sortSelect">
                <option value="default">как в каталоге</option>
                <option value="name-asc">название А–Я</option>
                <option value="name-desc">название Я–А</option>
              </select>
            </label>
          </div>

          <div class="grid-products" id="productsGrid">
            {products.map((p) => (
              <article
                class="product-card"
                data-category={p.category}
                data-subcategory={p.subcategory}
                data-title={p.title}
                data-id={p.id}
                data-article={p.article}
                data-volume={p.volume}
                data-brand={p.brand}
                data-image={p.images[0] || '/logo.svg'}
                data-search={[p.title, p.article, p.brand, p.subcategory, p.category].join(' ').toLowerCase()}
                data-tag-bg={tagColor.get(p.subcategory)?.bg}
                data-tag-fg={tagColor.get(p.subcategory)?.fg}
              >
                <div class="product-image">
                  <img src={p.images[0] || '/logo.svg'} alt={p.title} loading="lazy" onerror="this.src='/logo.svg'" />
                </div>
                <div class="product-info">
                  <span
                    class="category-tag"
                    style={`--tag-bg:${tagColor.get(p.subcategory)?.bg};--tag-fg:${tagColor.get(p.subcategory)?.fg}`}
                  >{p.subcategory}</span>
                  <h3>{p.title}</h3>
                  {p.short && <p class="short">{p.short}</p>}
                  <div class="product-footer">
                    <button type="button" class="btn btn-outline details-btn" data-id={p.id}>Подробнее</button>
                  </div>
                </div>
              </article>
            ))}
          </div>

          <nav class="pagination" id="pagination" aria-label="Страницы каталога" hidden></nav>

          <p class="empty-state" id="emptyState" hidden>Ничего не нашлось. Измените запрос или сбросьте фильтры.</p>
        </div>
      </div>
    </div>
  </section>

  <div class="modal-overlay" id="productModal">
    <div class="modal-content product-modal">
      <div class="modal-head">
        <span id="modalCategory" class="category-tag"></span>
        <button type="button" class="modal-close" id="closeModal" aria-label="Закрыть">&times;</button>
      </div>
      <div class="modal-body">
        <div class="modal-image">
          <img id="modalImg" src="" alt="" />
        </div>
        <div class="modal-text">
          <h2 id="modalTitle"></h2>
          <p id="modalMeta" class="modal-meta"></p>
          <div id="modalDesc" class="modal-desc"></div>
        </div>
      </div>
    </div>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const grid = document.getElementById('productsGrid');
      const cards = Array.from(grid.querySelectorAll('.product-card'));
      const catBtns = Array.from(document.querySelectorAll('#catFilters .filter-btn'));
      const subcatBtns = Array.from(document.querySelectorAll('#subcatFilters .filter-btn'));
      const resetBtn = document.getElementById('resetFilters');
      const sortSelect = document.getElementById('sortSelect');
      const countEl = document.getElementById('catalogCount');
      const emptyEl = document.getElementById('emptyState');
      const sidebar = document.getElementById('catalogSidebar');
      const filtersToggle = document.getElementById('filtersToggle');
      const filtersCount = document.getElementById('filtersCount');
      const pagination = document.getElementById('pagination');

      filtersToggle.addEventListener('click', () => {
        const open = sidebar.classList.toggle('open');
        filtersToggle.setAttribute('aria-expanded', String(open));
      });

      const brandBtns = Array.from(document.querySelectorAll('#brandFilters .filter-btn'));
      const searchInput = document.getElementById('searchInput');

      const state = { cat: 'Все', sub: 'Все', brand: 'Все', q: '', sort: 'default', page: 1 };
      const PER_PAGE = 24;

      const ordered = () => Array.from(grid.querySelectorAll('.product-card'));

      const plural = (n, one, few, many) => {
        const a = Math.abs(n) % 100;
        const b = a % 10;
        if (a > 10 && a < 20) return many;
        if (b === 1) return one;
        if (b >= 2 && b <= 4) return few;
        return many;
      };

      const field = (card, dim) =>
        dim === 'cat' ? card.dataset.category
          : dim === 'sub' ? card.dataset.subcategory
            : card.dataset.brand;

      const matches = (card) => {
        if (state.cat !== 'Все' && card.dataset.category !== state.cat) return false;
        if (state.sub !== 'Все' && card.dataset.subcategory !== state.sub) return false;
        if (state.brand !== 'Все' && card.dataset.brand !== state.brand) return false;
        if (state.q && !(card.dataset.search || '').includes(state.q)) return false;
        return true;
      };

      const renderPagination = (pages) => {
        pagination.innerHTML = '';
        pagination.hidden = pages <= 1;
        if (pages <= 1) return;

        const makeBtn = (label, page, opts = {}) => {
          const b = document.createElement('button');
          b.type = 'button';
          b.className = 'page-btn' + (opts.active ? ' active' : '');
          b.textContent = label;
          if (opts.disabled) {
            b.disabled = true;
            b.classList.add('disabled');
          } else {
            b.addEventListener('click', () => {
              state.page = page;
              apply();
              grid.scrollIntoView({ behavior: 'smooth', block: 'start' });
            });
          }
          return b;
        };

        pagination.appendChild(makeBtn('←', state.page - 1, { disabled: state.page === 1 }));

        const nums = [...new Set([1, pages, state.page - 1, state.page, state.page + 1])]
          .filter((n) => n >= 1 && n <= pages)
          .sort((a, b) => a - b);

        let prev = 0;
        for (const n of nums) {
          if (n - prev > 1) {
            const dots = document.createElement('span');
            dots.className = 'page-dots';
            dots.textContent = '…';
            pagination.appendChild(dots);
          }
          pagination.appendChild(makeBtn(String(n), n, { active: n === state.page }));
          prev = n;
        }

        pagination.appendChild(makeBtn('→', state.page + 1, { disabled: state.page === pages }));
      };

      const apply = () => {
        const list = ordered().filter(matches);
        const pages = Math.max(1, Math.ceil(list.length / PER_PAGE));
        if (state.page > pages) state.page = pages;

        const start = (state.page - 1) * PER_PAGE;
        const onPage = new Set(list.slice(start, start + PER_PAGE));

        cards.forEach((card) => {
          card.hidden = !onPage.has(card);
        });

        countEl.textContent = `${list.length} ${plural(list.length, 'товар', 'товара', 'товаров')}`;
        emptyEl.hidden = list.length !== 0;
        renderPagination(pages);

        const activeFilters =
          (state.cat !== 'Все' ? 1 : 0) +
          (state.sub !== 'Все' ? 1 : 0) +
          (state.brand !== 'Все' ? 1 : 0) +
          (state.q ? 1 : 0);
        filtersCount.textContent = String(activeFilters);
        filtersCount.hidden = activeFilters === 0;
      };

      const sortCards = () => {
        if (state.sort === 'default') {
          cards
            .slice()
            .sort((a, b) => Number(a.dataset.order) - Number(b.dataset.order))
            .forEach((card) => grid.appendChild(card));
          return;
        }

        const dir = state.sort === 'name-asc' ? 1 : -1;
        cards
          .slice()
          .sort((a, b) => dir * a.dataset.title.localeCompare(b.dataset.title, 'ru'))
          .forEach((card) => grid.appendChild(card));
      };

      const BTNS = { cat: catBtns, sub: subcatBtns, brand: brandBtns };

      const setActive = (btns, value) =>
        btns.forEach((b) => b.classList.toggle('active', b.dataset.value === value));

      // какие значения встречаются у товаров при остальных выбранных фильтрах
      const allowedValues = (dim) => {
        const set = new Set();
        ordered().forEach((card) => {
          if (dim !== 'cat' && state.cat !== 'Все' && card.dataset.category !== state.cat) return;
          if (dim !== 'sub' && state.sub !== 'Все' && card.dataset.subcategory !== state.sub) return;
          if (dim !== 'brand' && state.brand !== 'Все' && card.dataset.brand !== state.brand) return;
          const v = field(card, dim);
          if (v) set.add(v);
        });
        return set;
      };

      const syncAvailability = () => {
        ['cat', 'sub', 'brand'].forEach((dim) => {
          const allowed = allowedValues(dim);
          BTNS[dim].forEach((btn) => {
            btn.hidden = !(btn.dataset.value === 'Все' || allowed.has(btn.dataset.value));
          });
          if (state[dim] !== 'Все' && !allowed.has(state[dim])) {
            state[dim] = 'Все';
            setActive(BTNS[dim], 'Все');
          }
        });
      };

      const bindFilter = (btns, key) => {
        btns.forEach((btn) => {
          btn.addEventListener('click', () => {
            setActive(btns, btn.dataset.value);
            state[key] = btn.dataset.value;
            state.page = 1;
            syncAvailability();
            apply();
          });
        });
      };

      bindFilter(catBtns, 'cat');
      bindFilter(subcatBtns, 'sub');
      bindFilter(brandBtns, 'brand');

      let searchTimer = null;
      searchInput.addEventListener('input', () => {
        clearTimeout(searchTimer);
        searchTimer = setTimeout(() => {
          state.q = searchInput.value.trim().toLowerCase();
          state.page = 1;
          apply();
        }, 150);
      });

      resetBtn.addEventListener('click', () => {
        state.cat = 'Все';
        state.sub = 'Все';
        state.brand = 'Все';
        state.q = '';
        state.sort = 'default';
        state.page = 1;
        searchInput.value = '';
        sortSelect.value = 'default';
        Object.values(BTNS).forEach((btns) => {
          btns.forEach((b, i) => {
            b.classList.toggle('active', i === 0);
            b.hidden = false;
          });
        });
        sortCards();
        apply();
      });

      sortSelect.addEventListener('change', () => {
        state.sort = sortSelect.value;
        state.page = 1;
        sortCards();
        apply();
      });

      // исходный порядок для сортировки «как в каталоге»
      cards.forEach((card, i) => {
        card.dataset.order = String(i);
      });

      // ---- попап ----
      const modal = document.getElementById('productModal');
      const closeBtn = document.getElementById('closeModal');
      const modalImg = document.getElementById('modalImg');
      const modalTitle = document.getElementById('modalTitle');
      const modalDesc = document.getElementById('modalDesc');
      const modalCategory = document.getElementById('modalCategory');
      const modalMeta = document.getElementById('modalMeta');

      let descriptionsPromise = null;
      const loadDescriptions = () => {
        if (!descriptionsPromise) {
          descriptionsPromise = fetch('/catalog/data.json')
            .then((r) => (r.ok ? r.json() : {}))
            .catch(() => ({}));
        }
        return descriptionsPromise;
      };

      document.querySelectorAll('.details-btn').forEach((btn) => {
        btn.addEventListener('click', async (e) => {
          const card = e.currentTarget.closest('.product-card');
          if (!card) return;

          modalImg.src = card.dataset.image || '/logo.svg';
          modalImg.onerror = function () { this.src = '/logo.svg'; };
          modalTitle.textContent = card.dataset.title || '';
          modalCategory.textContent = card.dataset.subcategory || '';
          modalCategory.style.background = card.dataset.tagBg || '';
          modalCategory.style.color = card.dataset.tagFg || '';
          modalMeta.textContent = [card.dataset.volume, card.dataset.brand].filter(Boolean).join(' · ');
          modalDesc.innerHTML = '<p class="modal-loading">Загружаю описание…</p>';
          modal.classList.add('active');
          document.body.style.overflow = 'hidden';

          const descriptions = await loadDescriptions();
          modalDesc.innerHTML = descriptions[String(card.dataset.id)] || '';
        });
      });

      const close = () => {
        modal.classList.remove('active');
        document.body.style.overflow = '';
      };

      closeBtn.addEventListener('click', close);
      modal.addEventListener('click', (e) => {
        if (e.target === modal) close();
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && modal.classList.contains('active')) close();
      });

      apply();
    });
  </script>
</Base>

<style>
  .catalog-section { padding: 50px 0 80px; background: var(--bg-body); min-height: 80vh; }
  h1 { text-align: center; margin-bottom: 10px; }
  .lead { text-align: center; color: var(--text-muted); margin-bottom: 36px; }

  .catalog-layout {
    display: grid;
    grid-template-columns: 250px minmax(0, 1fr);
    gap: 28px;
    align-items: start;
  }

  /* ---------- сайдбар ---------- */
  .catalog-sidebar {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    padding: 18px 16px 20px;
    position: sticky;
    top: 92px;
  }

  .filters-toggle { display: none; }
  .filters-body { display: block; }

  .filter-block + .filter-block { margin-top: 22px; }

  .filter-title {
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--text-muted);
    margin: 0 0 10px;
    font-weight: 700;
  }

  .filters { display: flex; flex-direction: column; gap: 2px; }

  .filter-btn {
    display: block;
    width: 100%;
    text-align: left;
    padding: 8px 10px;
    background: transparent;
    border: 0;
    border-left: 3px solid transparent;
    font-family: inherit;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--text);
    cursor: pointer;
    transition: background 0.15s, color 0.15s, border-color 0.15s;
  }

  .filter-btn:hover { background: #f4f7f5; color: var(--brand-green-dark); }

  .filter-btn.active {
    background: var(--brand-green-light);
    color: var(--brand-green-dark);
    border-left-color: var(--brand-green);
    font-weight: 600;
  }

  .filter-reset {
    margin-top: 22px;
    width: 100%;
    padding: 9px 12px;
    background: transparent;
    border: 1px solid var(--border-color);
    font-family: inherit;
    font-size: 0.85rem;
    color: var(--text-muted);
    cursor: pointer;
    transition: border-color 0.15s, color 0.15s;
  }

  .filter-reset:hover { border-color: var(--brand-green); color: var(--brand-green); }

  /* ---------- тулбар ---------- */
  .catalog-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 18px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--border-color);
  }

  .catalog-count { color: var(--text-muted); font-size: 0.9rem; }

  .sort-label { display: flex; align-items: center; gap: 8px; font-size: 0.9rem; color: var(--text-muted); }

  .sort-label select {
    font-family: inherit;
    font-size: 0.9rem;
    padding: 6px 10px;
    border: 1px solid var(--border-color);
    background: var(--bg-card);
    color: var(--text);
    cursor: pointer;
  }

  /* ---------- сетка ---------- */
  .grid-products {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
  }

  .product-card {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    display: flex;
    flex-direction: column;
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .product-card[hidden] { display: none; }

  .product-card:hover { transform: translateY(-4px); box-shadow: 0 10px 25px rgba(0, 0, 0, 0.08); border-color: var(--brand-green); }

  .product-image {
    width: 100%;
    height: 180px;
    background: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 14px;
    border-bottom: 1px solid var(--border-color);
  }

  .product-image img { max-width: 100%; max-height: 100%; object-fit: contain; }

  .product-info { padding: 14px; display: flex; flex-direction: column; flex-grow: 1; }

  .category-tag {
    display: inline-block;
    background: var(--tag-bg, var(--brand-green-light));
    color: var(--tag-fg, var(--brand-green-dark));
    padding: 3px 8px;
    font-size: 0.68rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.3px;
    margin-bottom: 8px;
    align-self: flex-start;
  }

  .product-info h3 { margin: 0 0 8px 0; font-size: 0.92rem; line-height: 1.35; }

  .short { color: var(--text-muted); font-size: 0.82rem; line-height: 1.45; margin: 0 0 14px 0; flex-grow: 1; }

  .product-footer { display: flex; align-items: center; justify-content: flex-end; margin-top: auto; }
  .product-footer .btn { padding: 7px 12px; font-size: 0.8rem; }

  .empty-state { color: var(--text-muted); padding: 40px 0; text-align: center; }

  /* ---------- попап ---------- */
  .modal-overlay {
    position: fixed; inset: 0; background: rgba(0, 0, 0, 0.6);
    display: flex; align-items: center; justify-content: center;
    padding: 20px; z-index: 1000; opacity: 0; visibility: hidden; transition: 0.25s;
  }
  .modal-overlay.active { opacity: 1; visibility: visible; }

  .modal-content {
    background: var(--bg-card);
    width: 100%;
    max-width: 860px;
    max-height: 90vh;
    overflow-y: auto;
    position: relative;
    border-top: 4px solid var(--brand-green);
  }

  .modal-head {
    position: sticky;
    top: 0;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 12px 16px;
    background: var(--bg-card);
    border-bottom: 1px solid var(--border-color);
