---
import Base from '../layouts/Base.astro';
---
<Base title="Каталог — Сервисный центр Greenleaf в Геленджике">
  <section class="catalog-placeholder">
    <div class="container">
      <div class="placeholder-content">
        <h1>Каталог в процессе наполнения</h1>
        <p class="lead">Совсем скоро здесь появится полный ассортимент продукции Greenleaf с актуальными ценами и подробными описаниями.</p>
        <p class="sub-text">Следите за обновлениями! А пока вы можете связаться со мной для получения информации о наличии товаров.</p>
        <a href="/contacts" class="btn">Связаться со мной</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .catalog-placeholder {
    padding: 120px 0;
    background: var(--bg-body);
    min-height: 70vh;
    display: flex;
    align-items: center;
  }
  
  .container {
    max-width: 800px;
    margin: 0 auto;
    padding: 0 20px;
  }
  
  .placeholder-content {
    background: var(--bg-card);
    padding: 60px 40px;
    text-align: center;
    border: 1px solid var(--border-color);
    border-top: 4px solid var(--brand-green);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
  }
  
  h1 {
    font-size: 2.2rem;
    margin-bottom: 20px;
    color: var(--text);
  }
  
  .lead {
    font-size: 1.15rem;
    color: var(--text-muted);
    margin-bottom: 25px;
    line-height: 1.6;
  }
  
  .sub-text {
    font-size: 1rem;
    color: var(--text-muted);
    margin-bottom: 40px;
    max-width: 500px;
    margin-left: auto;
    margin-right: auto;
  }
</style>