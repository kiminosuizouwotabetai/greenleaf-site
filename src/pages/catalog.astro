---
import Base from '../layouts/Base.astro';
---
<Base
  title="Каталог продукции — Greenleaf в Геленджике"
  description="Полный каталог продукции Greenleaf: уход за кожей, волосами и телом, гигиена, здоровье, товары для дома и детей. Оформление заказа через партнёра в Геленджике."
>
  <section class="catalog-section">
    <div class="container">
      <h1>Каталог продукции</h1>
      <p class="lead">Ознакомьтесь с ассортиментом. Для заказа свяжитесь со мной.</p>

      <div class="catalog-layout">
        <aside class="catalog-sidebar" id="catalogSidebar">
          <button type="button" class="filters-toggle" id="filtersToggle" aria-expanded="false" aria-controls="filtersBody">
            <span class="filters-toggle-label">Фильтры</span>
            <span class="filters-toggle-count" id="filtersCount" hidden></span>
            <svg class="filters-toggle-chevron" viewBox="0 0 12 8" width="12" height="8" aria-hidden="true">
              <path d="M1 1.5L6 6.5L11 1.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>

          <div class="filters-body" id="filtersBody">
            <div class="filter-block">
              <h2 class="filter-title">Поиск</h2>
              <input
                type="search"
                id="searchInput"
                class="search-input"
                placeholder="Название или артикул"
                autocomplete="off"
                aria-label="Поиск по каталогу"
              />
            </div>

            <div class="filter-group">
              <button type="button" class="filter-group-head" data-panel="panelCat" aria-expanded="false" aria-controls="panelCat">
                <span class="fg-label">Категория</span>
                <span class="fg-value" id="catValue">Все</span>
                <svg class="fg-chevron" viewBox="0 0 12 8" width="11" height="7" aria-hidden="true">
                  <path d="M1 1.5L6 6.5L11 1.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
              <div class="filter-group-panel" id="panelCat" hidden></div>
            </div>

            <div class="filter-group">
              <button type="button" class="filter-group-head" data-panel="panelBrand" aria-expanded="false" aria-controls="panelBrand">
                <span class="fg-label">Бренд</span>
                <span class="fg-value" id="brandValue">Все</span>
                <svg class="fg-chevron" viewBox="0 0 12 8" width="11" height="7" aria-hidden="true">
                  <path d="M1 1.5L6 6.5L11 1.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
              <div class="filter-group-panel" id="panelBrand" hidden></div>
            </div>

            <button type="button" class="filter-reset" id="resetFilters">Сбросить фильтры</button>
          </div>
        </aside>

        <div class="catalog-main">
          <div class="catalog-toolbar">
            <span class="catalog-count" id="catalogCount">Загрузка…</span>
            <label class="sort-label">
              <span>Сортировка:</span>
              <select id="sortSelect">
                <option value="default">как в каталоге</option>
                <option value="name-asc">название А–Я</option>
                <option value="name-desc">название Я–А</option>
              </select>
            </label>
          </div>

          <div class="grid-products" id="productsGrid"></div>

          <nav class="pagination" id="pagination" aria-label="Страницы каталога" hidden></nav>

          <p class="empty-state" id="emptyState" hidden>Ничего не нашлось. Измените запрос или сбросьте фильтры.</p>

          <noscript>
            <p class="empty-state">
              Для работы каталога нужен JavaScript. Список категорий: уходовая косметика, гигиена, товары для дома,
              здоровье, товары для детей. Связаться со мной можно на странице контактов.
            </p>
          </noscript>
        </div>
      </div>
    </div>
  </section>

  <div class="modal-overlay" id="productModal">
    <div class="modal-content product-modal">
      <div class="modal-head">
        <span id="modalCategory" class="category-tag"></span>
        <button type="button" class="modal-close" id="closeModal" aria-label="Закрыть">&times;</button>
      </div>
      <div class="modal-body">
        <div class="modal-image">
          <img id="modalImg" src="" alt="" />
        </div>
        <div class="modal-text">
          <h2 id="modalTitle"></h2>
          <p id="modalMeta" class="modal-meta"></p>
          <div id="modalDesc" class="modal-desc"></div>
        </div>
      </div>
    </div>
  </div>

  <script is:inline>
    (() => {
      const PER_PAGE = 24;

      const PALETTE = [
        ['#E8F5EC', '#1E6D3A'], ['#FBEDE4', '#8A4B2A'], ['#EEEAF7', '#4B3A73'],
        ['#E6F1F8', '#22536B'], ['#F8F1E2', '#6B5326'], ['#FBEAEE', '#7A2F43'],
        ['#E4F4F2', '#1F5F58'], ['#EFF5E0', '#4C6A24'], ['#ECEEFA', '#3C3F78'],
        ['#F4EAF3', '#6A3A64'], ['#F0F2E3', '#555E2B'], ['#FDEDE7', '#8A4130'],
        ['#E9F0F7', '#2C5170'], ['#FBF6E4', '#6E5A22'], ['#F3E9F0', '#5E3552'],
        ['#EAF2E1', '#3F6B2E'], ['#FBEFE9', '#7A4630'], ['#F7F0F4', '#6B3A56'],
        ['#E7F3F0', '#1D5C56'], ['#F6F3EA', '#5F5533'], ['#EFF2F8', '#33436B'],
        ['#F9F0E9', '#74492F'],
      ];

      const colorOf = (str) => {
        let h = 0;
        for (let i = 0; i < str.length; i += 1) h = (h * 31 + str.charCodeAt(i)) % 997;
        return PALETTE[h % PALETTE.length];
      };

      const esc = (s) =>
        String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');

      const plural = (n) => {
        const a = Math.abs(n) % 100;
        const b = a % 10;
        if (a > 10 && a < 20) return 'товаров';
        if (b === 1) return 'товар';
        if (b >= 2 && b <= 4) return 'товара';
        return 'товаров';
      };

      const state = { cat: 'Все', sub: 'Все', brand: 'Все', q: '', sort: 'default', page: 1 };
      let DATA = { products: [], categories: [], brands: [] };
      let descriptions = null;

      const grid = document.getElementById('productsGrid');
      const countEl = document.getElementById('catalogCount');
      const emptyEl = document.getElementById('emptyState');
      const pagination = document.getElementById('pagination');
      const sortSelect = document.getElementById('sortSelect');
      const searchInput = document.getElementById('searchInput');
      const sidebar = document.getElementById('catalogSidebar');
      const filtersToggle = document.getElementById('filtersToggle');
      const filtersCount = document.getElementById('filtersCount');
      const resetBtn = document.getElementById('resetFilters');

      const catPanel = document.getElementById('panelCat');
      const brandPanel = document.getElementById('panelBrand');
      const catValue = document.getElementById('catValue');
      const brandValue = document.getElementById('brandValue');

      filtersToggle.addEventListener('click', () => {
        const open = sidebar.classList.toggle('open');
        filtersToggle.setAttribute('aria-expanded', String(open));
      });

      document.querySelectorAll('.filter-group-head').forEach((head) => {
        head.addEventListener('click', () => {
          const panel = document.getElementById(head.dataset.panel);
          const willOpen = panel.hidden;
          panel.hidden = !willOpen;
          head.setAttribute('aria-expanded', String(willOpen));
        });
      });

      const visibleProducts = () =>
        DATA.products.filter(
          (p) =>
            (state.cat === 'Все' || p.cat === state.cat) &&
            (state.sub === 'Все' || p.sub === state.sub) &&
            (state.brand === 'Все' || p.brand === state.brand) &&
            (!state.q || p.search.includes(state.q)),
        );

      const renderFilters = () => {
        // подкатегория должна существовать в выбранной категории
        const catSubs =
          state.cat === 'Все'
            ? null
            : DATA.categories.find((c) => c.name === state.cat)?.subs ?? [];
        if (state.sub !== 'Все' && catSubs && !catSubs.includes(state.sub)) state.sub = 'Все';

        // --- категории (+ подкатегории под выбранной) ---
        catPanel.innerHTML = '';
        ['Все', ...DATA.categories.map((c) => c.name)].forEach((name) => {
          const row = document.createElement('div');
          row.className = 'cat-row';

          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'filter-btn' + (state.cat === name ? ' active' : '');
          btn.dataset.value = name;
          btn.textContent = name;
          btn.addEventListener('click', () => {
            state.cat = name;
            state.sub = 'Все';
            state.page = 1;
            renderFilters();
            render();
          });
          row.appendChild(btn);

          if (name !== 'Все' && state.cat === name) {
            const subs = DATA.categories.find((c) => c.name === name)?.subs ?? [];
            if (subs.length > 1) {
              const subRow = document.createElement('div');
              subRow.className = 'sub-row';
              ['Все', ...subs].forEach((sub) => {
                const chip = document.createElement('button');
                chip.type = 'button';
                chip.className = 'sub-chip' + (state.sub === sub ? ' active' : '');
                chip.dataset.value = sub;
                chip.textContent = sub;
                chip.addEventListener('click', () => {
                  state.sub = sub;
                  state.page = 1;
                  renderFilters();
                  render();
                });
                subRow.appendChild(chip);
              });
              row.appendChild(subRow);
            }
          }

          catPanel.appendChild(row);
        });

        // --- бренды, доступные при текущем выборе ---
        const brands = new Set(visibleProducts().map((p) => p.brand).filter(Boolean));
        if (state.brand !== 'Все' && !brands.has(state.brand)) state.brand = 'Все';

        brandPanel.innerHTML = '';
        ['Все', ...DATA.brands.filter((b) => brands.has(b))].forEach((brand) => {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'filter-btn' + (state.brand === brand ? ' active' : '');
          btn.dataset.value = brand;
          btn.textContent = brand;
          btn.addEventListener('click', () => {
            state.brand = brand;
            state.page = 1;
            renderFilters();
            render();
          });
          brandPanel.appendChild(btn);
        });

        catValue.textContent = state.cat;
        brandValue.textContent = state.brand;
      };

      const cardHtml = (p) => {
        const [bg, fg] = colorOf(p.sub);
        return `<article class="product-card" data-id="${p.id}">
          <div class="product-image">
            <img src="${esc(p.img)}" alt="${esc(p.title)}" loading="lazy" />
          </div>
          <div class="product-info">
            <span class="category-tag" style="--tag-bg:${bg};--tag-fg:${fg}">${esc(p.sub)}</span>
            <h3>${esc(p.title)}</h3>
            ${p.short ? `<p class="short">${esc(p.short)}</p>` : ''}
            <div class="product-footer">
              <button type="button" class="btn btn-outline details-btn" data-id="${p.id}">Подробнее</button>
            </div>
          </div>
        </article>`;
      };

      const renderPagination = (pages) => {
        pagination.innerHTML = '';
        pagination.hidden = pages <= 1;
        if (pages <= 1) return;

        const btn = (label, page, opts = {}) => {
          const b = document.createElement('button');
          b.type = 'button';
          b.className = 'page-btn' + (opts.nav ? ' nav' : '') + (opts.active ? ' active' : '');
          b.textContent = label;
          if (opts.disabled) {
            b.disabled = true;
            b.classList.add('disabled');
          } else {
            b.addEventListener('click', () => {
              state.page = page;
              render();
              grid.scrollIntoView({ behavior: 'smooth', block: 'start' });
            });
          }
          return b;
        };

        pagination.appendChild(btn('←', state.page - 1, { disabled: state.page === 1, nav: true }));

        const nums = [...new Set([1, pages, state.page - 2, state.page - 1, state.page, state.page + 1, state.page + 2])]
          .filter((n) => n >= 1 && n <= pages)
          .sort((a, b) => a - b);

        let prev = 0;
        nums.forEach((n) => {
          if (n - prev > 1) {
            const dots = document.createElement('span');
            dots.className = 'page-dots';
            dots.textContent = '…';
            pagination.appendChild(dots);
          }
          pagination.appendChild(btn(String(n), n, { active: n === state.page }));
          prev = n;
        });

        pagination.appendChild(btn('→', state.page + 1, { disabled: state.page === pages, nav: true }));
      };

      const render = () => {
        const list = visibleProducts().slice().sort((a, b) => {
          if (state.sort === 'name-asc') return a.title.localeCompare(b.title, 'ru');
          if (state.sort === 'name-desc') return b.title.localeCompare(a.title, 'ru');
          return a.order - b.order;
        });

        const pages = Math.max(1, Math.ceil(list.length / PER_PAGE));
        if (state.page > pages) state.page = pages;

        const start = (state.page - 1) * PER_PAGE;
        grid.innerHTML = list.slice(start, start + PER_PAGE).map(cardHtml).join('');

        countEl.textContent = `${list.length} ${plural(list.length)}`;
        emptyEl.hidden = list.length !== 0;
        renderPagination(pages);

        const active = (state.cat !== 'Все' ? 1 : 0) + (state.sub !== 'Все' ? 1 : 0) +
          (state.brand !== 'Все' ? 1 : 0) + (state.q ? 1 : 0);
        filtersCount.textContent = String(active);
        filtersCount.hidden = active === 0;
      };

      const loadDescriptions = () => {
        if (!descriptions) {
          descriptions = fetch('/catalog/descriptions.json')
            .then((r) => (r.ok ? r.json() : {}))
            .catch(() => ({}));
        }
        return descriptions;
      };

      // ---- попап ----
      const modal = document.getElementById('productModal');
      const closeBtn = document.getElementById('closeModal');
      const modalImg = document.getElementById('modalImg');
      const modalTitle = document.getElementById('modalTitle');
      const modalDesc = document.getElementById('modalDesc');
      const modalCategory = document.getElementById('modalCategory');
      const modalMeta = document.getElementById('modalMeta');

      grid.addEventListener('click', async (e) => {
        const btn = e.target.closest('.details-btn');
        if (!btn) return;

        const id = Number(btn.dataset.id);
        const p = DATA.products.find((x) => x.id === id);
        if (!p) return;

        const [bg, fg] = colorOf(p.sub);
        modalImg.src = p.img;
        modalImg.onerror = function () { this.src = '/logo.svg'; };
        modalTitle.textContent = p.title;
        modalCategory.textContent = p.sub;
        modalCategory.style.background = bg;
        modalCategory.style.color = fg;
        modalMeta.textContent = [p.vol, p.brand, p.article ? `арт. ${p.article}` : ''].filter(Boolean).join(' · ');
        modalDesc.innerHTML = '<p class="modal-loading">Загружаю описание…</p>';
        modal.classList.add('active');
        document.body.style.overflow = 'hidden';

        const all = await loadDescriptions();
        modalDesc.innerHTML = all[String(p.id)] || '<p>Описание скоро появится.</p>';
      });

      const close = () => {
        modal.classList.remove('active');
        document.body.style.overflow = '';
      };

      closeBtn.addEventListener('click', close);
      modal.addEventListener('click', (e) => {
        if (e.target === modal) close();
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && modal.classList.contains('active')) close();
      });

      // ---- фильтры ----
      let searchTimer = null;
      searchInput.addEventListener('input', () => {
        clearTimeout(searchTimer);
        searchTimer = setTimeout(() => {
          state.q = searchInput.value.trim().toLowerCase();
          state.page = 1;
          renderFilters();
          render();
        }, 150);
      });

      sortSelect.addEventListener('change', () => {
        state.sort = sortSelect.value;
        state.page = 1;
        render();
      });

      resetBtn.addEventListener('click', () => {
        state.cat = 'Все';
        state.sub = 'Все';
        state.brand = 'Все';
        state.q = '';
        state.sort = 'default';
        state.page = 1;
        searchInput.value = '';
        sortSelect.value = 'default';
        renderFilters();
        render();
      });

      // ---- загрузка ----
      fetch('/catalog/data.json')
        .then((r) => r.json())
        .then((data) => {
          data.products.forEach((p, i) => {
            p.order = i;
            p.search = `${p.title} ${p.article} ${p.brand} ${p.sub} ${p.cat}`.toLowerCase();
          });
          DATA = data;
          renderFilters();
          render();
        })
        .catch(() => {
          countEl.textContent = 'Не удалось загрузить каталог';
        });
    })();
  </script>
</Base>

<style is:global>
  .catalog-section { padding: 50px 0 80px; background: var(--bg-body); min-height: 80vh; }
  h1 { text-align: center; margin-bottom: 10px; }
  .lead { text-align: center; color: var(--text-muted); margin-bottom: 36px; }

  .catalog-layout {
    display: grid;
    grid-template-columns: 250px minmax(0, 1fr);
    gap: 28px;
    align-items: start;
  }

  .catalog-sidebar {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    padding: 18px 16px 20px;
    position: sticky;
    top: 92px;
    max-height: calc(100vh - 110px);
    overflow-y: auto;
  }

  .filters-toggle { display: none; }
  .filters-body { display: block; }

  .filter-block + .filter-block { margin-top: 20px; }

  .filter-title {
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--text-muted);
    margin: 0 0 10px;
    font-weight: 700;
  }

  /* ---------- аккордеон фильтров ---------- */
  .filter-group { border-top: 1px solid var(--border-color); }
  .filter-group:first-of-type { margin-top: 18px; }

  .filter-group-head {
    display: flex;
    align-items: center;
    gap: 8px;
    width: 100%;
    padding: 13px 2px;
    background: none;
    border: 0;
    font-family: inherit;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    color: var(--text-muted);
    cursor: pointer;
    text-align: left;
  }

  .filter-group-head:hover { color: var(--brand-green); }

  .fg-value {
    margin-left: auto;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0;
    text-transform: none;
    color: var(--brand-green-dark);
    max-width: 130px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .fg-chevron { flex-shrink: 0; transition: transform 0.2s; }
  .filter-group-head[aria-expanded="true"] .fg-chevron { transform: rotate(180deg); }

  .filter-group-panel { padding: 0 0 14px; }

  .cat-row + .cat-row { border-top: 1px dashed #eef1ee; }

  .sub-row {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    padding: 2px 0 10px 12px;
  }

  .sub-chip {
    padding: 5px 10px;
    border: 1px solid var(--border-color);
    background: var(--bg-card);
    font-family: inherit;
    font-size: 0.78rem;
    color: var(--text-muted);
    cursor: pointer;
    transition: color 0.15s, border-color 0.15s, background 0.15s;
  }

  .sub-chip:hover { border-color: var(--brand-green); color: var(--brand-green); }
  .sub-chip.active { background: var(--brand-green-light); border-color: var(--brand-green); color: var(--brand-green-dark); font-weight: 600; }

  .filters { display: flex; flex-direction: column; gap: 2px; }

  .filter-btn {
    display: block;
    width: 100%;
    text-align: left;
    padding: 7px 10px;
    background: transparent;
    border: 0;
    border-left: 3px solid transparent;
    font-family: inherit;
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--text);
    cursor: pointer;
    transition: background 0.15s, color 0.15s, border-color 0.15s;
  }

  .filter-btn:hover { background: #f4f7f5; color: var(--brand-green-dark); }

  .filter-btn.active {
    background: var(--brand-green-light);
    color: var(--brand-green-dark);
    border-left-color: var(--brand-green);
    font-weight: 600;
  }

  .filter-reset {
    margin-top: 20px;
    width: 100%;
    padding: 9px 12px;
    background: transparent;
    border: 1px solid var(--border-color);
    font-family: inherit;
    font-size: 0.85rem;
    color: var(--text-muted);
    cursor: pointer;
  }

  .filter-reset:hover { border-color: var(--brand-green); color: var(--brand-green); }

  .search-input {
    width: 100%;
    padding: 8px 10px;
    border: 1px solid var(--border-color);
    background: var(--bg-card);
    font-family: inherit;
    font-size: 0.9rem;
    color: var(--text);
  }
  .search-input:focus { outline: none; border-color: var(--brand-green); }

  .catalog-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 18px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--border-color);
  }

  .catalog-count { color: var(--text-muted); font-size: 0.9rem; }
  .sort-label { display: flex; align-items: center; gap: 8px; font-size: 0.9rem; color: var(--text-muted); }

  .sort-label select {
    font-family: inherit;
    font-size: 0.9rem;
    padding: 6px 10px;
    border: 1px solid var(--border-color);
    background: var(--bg-card);
    color: var(--text);
    cursor: pointer;
  }

  .grid-products {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
  }

  .product-card {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    display: flex;
    flex-direction: column;
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .product-card:hover { transform: translateY(-4px); box-shadow: 0 10px 25px rgba(0, 0, 0, 0.08); border-color: var(--brand-green); }

  .product-image {
    width: 100%;
    height: 180px;
    background: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 14px;
    border-bottom: 1px solid var(--border-color);
  }

  .product-image img { max-width: 100%; max-height: 100%; object-fit: contain; }

  .product-info { padding: 14px; display: flex; flex-direction: column; flex-grow: 1; }

  .category-tag {
    display: inline-block;
    background: var(--tag-bg, var(--brand-green-light));
    color: var(--tag-fg, var(--brand-green-dark));
    padding: 3px 8px;
    font-size: 0.68rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.3px;
    margin-bottom: 8px;
